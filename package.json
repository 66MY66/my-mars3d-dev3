{
  "name": "mars3d-vue-project",
  "version": "3.10.12",
  "description": "在Vue3技术栈下的Mars3D平台 基础项目",
  "scripts": {
    "dev": "vite",
    "serve": "npm run clean-cache && vite --host",
    "clean-cache": "node -e \"const fs=require('fs'); const path=require('path'); const base='node_modules'; const targets=['.cache']; try{for(const name of fs.readdirSync(base)){ if(name==='.vite' || name.startsWith('.vite-')) targets.push(name);} }catch{}; for(const t of targets){ fs.rmSync(path.join(base,t),{recursive:true,force:true}); }\"",
    "clean-lib": "node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true});\"",
    "preview": "vite preview",
    "build": "npm run lint && vite build",
    "build2": "node --max_old_space_size=1024000 ./node_modules/vite/bin/vite.js build",
    "serve:dist": "http-server ./dist",
    "lint": "vue-tsc --noEmit --skipLibCheck && npm run eslint",
    "eslint": "eslint \"src/**/*.{js,vue,ts}\" --fix",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky install",
    "postinstall": "node --input-type=commonjs -e \"const ua=process.env.npm_config_user_agent||''; if(/pnpm\\\\//.test(ua)) process.exit(0); const fs=require('fs'); const path=require('path'); const cp=require('child_process'); const root=process.cwd(); const marsDir=path.join(root,'node_modules','mars3d'); const pkgPath=path.join(marsDir,'package.json'); if(!fs.existsSync(pkgPath)) process.exit(0); let v=''; try{v=JSON.parse(fs.readFileSync(pkgPath,'utf8')).version||'';}catch{process.exit(0);} if(String(v).trim()!=='3.10.12') process.exit(0); const patchFile=path.join(root,'patches','mars3d@3.10.12.patch'); if(!fs.existsSync(patchFile)) process.exit(0); try{cp.execFileSync('patch',['--batch','--forward','-p1','-i',patchFile],{cwd:marsDir,stdio:'inherit'});}catch{process.exit(0);}\""
  },
  "type": "module",
  "dependencies": {
    "@icon-park/svg": "^1.4.2",
    "@mapbox/vector-tile": "^3.0.0",
    "@turf/turf": "^7.2.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.10.0",
    "core-js": "^3.43.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "echarts-gl": "^2.0.9",
    "font-awesome": "^4.7.0",
    "gifenc": "^1.0.3",
    "idb-keyval": "^6.2.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "kml-geojson": "^2.0.1",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "mapv": "^2.0.62",
    "mars3d": "3.10.12",
    "mars3d-cesium": "~1.133.2",
    "mars3d-echarts": "3.10.12",
    "mars3d-heatmap": "3.10.12",
    "mars3d-mapv": "3.10.12",
    "mars3d-space": "3.10.12",
    "mars3d-tdt": "3.10.12",
    "mp4-muxer": "^5.2.2",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pbf": "^5.1.2",
    "simple-statistics": "7.8.8",
    "spark-md5": "^3.0.2",
    "shpjs": "^6.1.0",
    "three": "0.180.0",
    "uuid": "^9.0.1",
    "vue": "^3.5.20",
    "vue-color-kit": "^1.0.6",
    "vue-router": "^4.5.1",
    "vuex": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.19.1",
    "@types/spark-md5": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/server-renderer": "^3.5.20",
    "@vue/test-utils": "^2.4.10",
    "consola": "^3.4.2",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.33.0",
    "fs-extra": "^11.3.0",
    "http-server": "^14.1.1",
    "husky": "^8.0.3",
    "jsdom": "^28.1.0",
    "less": "^4.3.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^5.14.0",
    "serve-static": "^1.16.2",
    "standard": "^17.1.2",
    "terser": "^5.43.0",
    "typescript": "~5.2.2",
    "vite": "^7.1.2",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-mars3d": "^4.2.2",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-style-import": "^2.0.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^1.8.27",
    "workbox-window": "^7.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marsgis/mars3d-vue-project.git"
  },
  "bugs": {
    "url": "https://github.com/marsgis/mars3d-vue-project/issues",
    "email": "wh@marsgis.cn"
  },
  "keywords": [
    "marsgis",
    "mars3d",
    "cesium",
    "vue",
    "vue3",
    "gis",
    "webgis"
  ],
  "author": "火星科技",
  "license": "Apache-2.0",
  "homepage": "http://mars3d.cn",
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "npm run eslint"
    ]
  },
  "pnpm": {
    "patchedDependencies": {
      "mars3d@3.10.12": "patches/mars3d@3.10.12.patch"
    }
  }
}
